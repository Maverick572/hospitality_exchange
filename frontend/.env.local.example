# Copy to .env.local and fill in.

# FastAPI backend (see backend/main.py). Its CORS only allows port 5173,
# which is why `npm run dev` runs on 5173.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Firebase web app config: Firebase Console → Project settings → Your apps.
# This is NOT the backend's service-account key. Leave these empty to run in
# demo mode, where any email signs in using the backend's `test-` token bypass.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
