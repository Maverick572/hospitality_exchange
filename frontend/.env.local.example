# Copy to .env.local and fill in.

# FastAPI backend (see backend/main.py). Its CORS only allows port 5173,
# which is why `npm run dev` runs on 5173.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Firebase web app config: Firebase Console → Project settings → Your apps.
# This is NOT the backend's service-account key.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id
