# ============================================================
# Application
# ============================================================

APP_NAME=Hospitality Resource Exchange
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000


# ============================================================
# Firebase
# ============================================================

FIREBASE_SERVICE_ACCOUNT_FILE=hospitality-exchange-370a7-firebase-adminsdk-fbsvc-85c9cf1650.json
FIREBASE_PROJECT_ID=hospitality-exchange-370a7
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your_firebase_web_api_key


# ============================================================
# Groq (LLM Requirement Parser)
# ============================================================

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15


# ============================================================
# Routing / OSRM
# ============================================================

OSRM_BASE_URL=https://router.project-osrm.org


# ============================================================
# Reddit API (Weather & Social Scraping)
# ============================================================

REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=HospitalityExchange/1.0 by your_username
REDDIT_USERNAME=
REDDIT_PASSWORD=


# ============================================================
# CORS
# ============================================================

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173