# ============================================================
# Hospitality Resource Exchange - Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Groq API (LLM Requirement Parser)
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15

# ------------------------------------------------------------
# Firebase Admin SDK (Backend Firestore, Auth, Storage)
# ------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase Web API Key (for client auth testing)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ------------------------------------------------------------
# Routing / OSRM (Distance & Route Matching)
# ------------------------------------------------------------
OSRM_BASE_URL=http://router.project-osrm.org

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
